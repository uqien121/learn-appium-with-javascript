{
  "name": "learn-appium-with-javascript",
  "version": "1.0.0",
  "description": "Học Appium với JavaScript — WebdriverIO v9 + Appium v3",

  "type": "module",

  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },

  "scripts": {
    "test:android": "wdio run config/wdio.android.conf.js",
    "test:ios":     "wdio run config/wdio.ios.conf.js",
    "test":         "wdio run config/wdio.conf.js",

    "appium":       "appium",
    "appium:check": "appium-doctor --android"
  },

  "devDependencies": {
    "@wdio/appium-service":    "^9.0.0",
    "@wdio/cli":               "^9.0.0",
    "@wdio/local-runner":      "^9.0.0",
    "@wdio/mocha-framework":   "^9.0.0",
    "@wdio/spec-reporter":     "^9.0.0",
    "appium":                  "^3.0.0",
    "appium-uiautomator2-driver": "^3.0.0",
    "appium-xcuitest-driver":  "^7.0.0",
    "webdriverio":             "^9.0.0"
  }
}
